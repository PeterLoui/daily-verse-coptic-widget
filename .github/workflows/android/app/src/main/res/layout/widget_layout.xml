<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="@drawable/bg_liquid_glass"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/coptic_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="10 بشنس 1742 للشهداء"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.9"/>
        <TextView
            android:id="@+id/greg_date"
            android:layout_width="wrap_content"
            android:text="18 مايو 2026"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:alpha="0.6"/>
    </LinearLayout>

    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="أَسْتَطِيعُ كُلَّ شَيْءٍ فِي الْمَسِيحِ الَّذِي يُقَوِّينِي"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verse_ref"
        android:layout_width="match_parent"
        android:text="فيلبي 4:13"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:alpha="0.75"
        android:textSize="12sp"/>
</LinearLayout>
